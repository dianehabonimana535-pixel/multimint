# --- IPFS (Pinata) ---
# Create a free account at https://pinata.cloud, then generate a JWT under
# API Keys with "pinFileToIPFS" and "pinJSONToIPFS" permissions.
# This stays server-side only (used in app/api/upload/route.ts) and is
# never exposed to the browser.
PINATA_JWT=

# Optional: custom Pinata gateway domain (defaults to gateway.pinata.cloud)
PINATA_GATEWAY=gateway.pinata.cloud

# Optional: public URL of your deployment (used for metadata and "Share on X" links)
NEXT_PUBLIC_SITE_URL=

# --- Solana RPC ---
# Public mainnet RPC is heavily rate-limited. For production, use a paid
# RPC provider: Helius, QuickNode, Triton, Alchemy, etc.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- BNB Smart Chain RPC ---
# The public bsc-dataseed.binance.org endpoint is used by default. For
# production, use a paid/free-tier RPC provider for reliability: Ankr,
# NodeReal, QuickNode, GetBlock, etc.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- BNB Smart Chain Testnet RPC ---
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- WalletConnect (EVM networks) ---
# Free projectId from https://cloud.walletconnect.com — lets mobile wallets
# (Trust Wallet, Binance Wallet, etc.) connect via QR code. The injected
# MetaMask browser extension works even without this, but set it for full
# wallet support. Solana wallets do not need it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Robinhood Chain (Arbitrum Orbit L2, gas in ETH) ---
# Mainnet chain ID 4663, testnet chain ID 46630. The public endpoints below are
# rate limited; use a dedicated provider (Chainstack, QuickNode, OrbitFlare...)
# for production.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# --- Solana Devnet RPC (used when the switcher is on "Sol Dev") ---
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
